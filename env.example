# Pipedrive API Configuration
# Copy this file to .env.local and fill in your actual values

# Standard Pipedrive library variables
PIPEDRIVE_API_TOKEN=your_pipedrive_api_token_here
PIPEDRIVE_DOMAIN=your_pipedrive_domain_here

# onRevolt CRM database and server-side uploads
DATABASE_URL="mysql://user:password@127.0.0.1:3306/onrevolt_crm"
ONREVOLT_UPLOAD_DIR="/var/www/vhosts/onrevolt.com/my.onrevolt.com/uploads/crm"
ONREVOLT_CREDENTIAL_SECRET="change-me-to-a-long-random-secret"
# Osobne połączenie do starej bazy RE/my.onrevolt.com z tabelą EnergyMeter_users.
ONREVOLT_RE_DATABASE_URL="mysql://user:password@127.0.0.1:3306/data_stats"
# Katalog metadanych wydań OTA Solis; firmware znajduje się w sąsiednim katalogu firmware.
ONREVOLT_SOLIS_RELEASES_URL="https://windyone.pl/OTA/Solis/catalog.php"

# Google Maps: wyszukiwanie adresu i zdjęcie satelitarne na pierwszej stronie oferty.
# W Google Cloud włącz Geocoding API i Maps Static API. Klucz pozostaje wyłącznie po stronie serwera.
GOOGLE_MAPS_API_KEY=

# OSW / One Stop Warehouse catalog synchronization
# OSW_PRODUCTS_URL może wskazywać JSON/eksport widoczny po zalogowaniu.
# Jeśli jest puste, synchronizacja czyta lokalne URL-e dostawcy z katalogu produktów i pomija produkty bez URL.
OSW_PRODUCTS_URL=
# Oficjalny endpoint API używany przez osw.energy do cen i dostępności po zalogowaniu.
OSW_API_HOST=https://plapi.solarbrain.com.au
OSW_API_PREFIX=/api
OSW_API_TOKEN=
# Alternatywa dla API tokena: pełny nagłówek Cookie z zalogowanej sesji OSW.
OSW_SESSION_COOKIE=
OSW_EMAIL=
OSW_PASSWORD=
# Opcjonalne, gdy automatyczne wykrycie formularza logowania OSW nie wystarczy.
OSW_LOGIN_URL=
OSW_LOGIN_EMAIL_FIELD=
OSW_LOGIN_PASSWORD_FIELD=
# JSON albo querystring, np. {"store":"pl"} albo store=pl&remember=1.
OSW_LOGIN_EXTRA_FIELDS=
# Tylko dla endpointów używających HTTP Basic zamiast formularza logowania.
OSW_BASIC_AUTH=
OSW_DEFAULT_PURCHASE_VAT_RATE=
OSW_DEFAULT_OPERATING_COST_NET=
OSW_DEFAULT_MARGIN_RATE=
OSW_DEFAULT_SALE_VAT_RATE=

# Environment
NODE_ENV=development
