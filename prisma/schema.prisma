generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum StaffRoleCode {
  ADMIN
  SZEF
  SPRZEDAWCA
  MONTER
  SERWIS
  KSIEGOWOSC
}

enum StaffSystemRole {
  ADMIN
  MODERATOR
  USER
}

enum CompanyRoleCode {
  SZEF
  KOORDYNATOR
  SPRZEDAWCA
  MONTER
  ELEKTRYK
  SERWIS
  PROJEKTANT
  DEVELOPER
  KSIEGOWOSC
  BIURO
  PODWYKONAWCA
}

enum ClientType {
  UNKNOWN
  B2C
  B2B
  B2C_B2B
}

enum ProjectStatus {
  LEAD
  CZEKA_NA_KALKULACJE
  W_TRAKCIE_OBSLUGI
  OFERTA_PRZYGOTOWANA
  OFERTA_ZAAKCEPTOWANA
  ZALICZKA_MONTAZ
  PROCEDURA_OSD
  ODBIOR
  ZAKONCZONY
  SERWIS
  WSTRZYMANY
}

enum TaskStatus {
  OPEN
  IN_PROGRESS
  DONE
  CANCELLED
}

enum TaskPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum ReminderChannel {
  PANEL
  EMAIL
}

enum ActivityType {
  CALL
  EMAIL
  MEETING
  NOTE
  STATUS_CHANGE
  SYSTEM
}

enum EnergyAuditStatus {
  DRAFT
  READY
  APPROVED
}

enum SiteAuditStatus {
  DRAFT
  COMPLETED
}

enum EnergyProfileSource {
  ANNUAL_DECLARATION
  MONTHLY_MANUAL
  OPERATOR_HOURLY
}

enum ProductCategory {
  MAGAZYN_ENERGII
  FALOWNIK
  INWERTER
  FOTOWOLTAIKA
  LICZNIK_GRID
  OSPRZET_ELEKTRONIKA
  USLUGA_MONTAZOWA
  KOSZTY_OPERACYJNE
  MONITOROWANIE
  SYSTEM_MONITORUJACY
  INNE
}

enum ConfigurationKind {
  PV_DACH_PLASKI
  PV_DACH_SKOSNY
  MAGAZYN
  EMS
  MIXED
}

enum ConfigurationStatus {
  DRAFT
  READY
  OFFERED
  ACCEPTED
  INSTALLED
  ARCHIVED
}

enum ConfigurationVatMode {
  REDUCED_8
  STANDARD_23
  MIXED
  REVIEW
}

enum ConfigurationRoofType {
  FLAT
  SLOPED
  GROUND
  OTHER
  UNKNOWN
}

enum ConfigurationGoal {
  NEW_PV
  PV_WITH_STORAGE
  STORAGE_RETROFIT
  PV_EXPANSION
  INVERTER_REPLACEMENT
  EMS_MONITORING
  SERVICE_ONLY
  MIXED
}

enum ConfigurationItemSupplyMode {
  ONREVOLT_SUPPLIED
  CLIENT_OWNED_USED
  CLIENT_SUPPLIED_NEW
  SERVICE_ONLY
  NOT_INCLUDED
}

enum ConfigurationItemRole {
  MAIN_EQUIPMENT
  ACCESSORY
  MOUNTING
  CABLING
  PROTECTION
  MONITORING
  FORMALITIES
  LOGISTICS
  LABOR
  DESIGN
  OTHER
}

enum ExistingAssetKind {
  PV_MODULES
  PV_INVERTER
  HYBRID_INVERTER
  BATTERY
  GRID_METER
  EMS
  PROTECTION
  CABLING
  OTHER
}

enum ExistingAssetVerificationStatus {
  DECLARED
  PHOTO_CONFIRMED
  DOCUMENT_CONFIRMED
  AUDIT_CONFIRMED
  UNKNOWN
}

enum ExistingAssetCompatibilityStatus {
  UNKNOWN
  COMPATIBLE
  NEEDS_AUDIT
  INCOMPATIBLE
}

enum OfferStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
  EXPIRED
}

enum ContractStatus {
  DRAFT
  SIGNED
  CANCELLED
  COMPLETED
}

enum InstallationStatus {
  TO_SCHEDULE
  PLANNED
  CONFIRMED
  IN_PROGRESS
  NEEDS_COMPLETION
  WAITING_OSD
  COMPLETED
  SERVICE_REQUIRED
}

enum PurchaseOrderStatus {
  DRAFT
  ORDERED
  PARTIAL
  DELIVERED
  CANCELLED
}

enum StockReservationStatus {
  RESERVED
  RELEASED
  ISSUED
  CANCELLED
}

enum OdsCaseStatus {
  PREPARATION
  READY_TO_SUBMIT
  SUBMITTED
  CORRECTION_REQUIRED
  ACCEPTED
  METER_WORK
  COMPLETED
  CANCELLED
}

enum ServiceTicketStatus {
  NEW
  DIAGNOSIS
  SCHEDULED
  IN_PROGRESS
  WAITING_PARTS
  RESOLVED
  CLOSED
}

enum DocumentType {
  FAKTURA_PRAD
  ENEA_ZUZYCIE
  ENEA_PRODUKCJA
  OFERTA
  UMOWA
  PROTOKOL
  ZDJECIE_MONTAZU
  DOKUMENT_OSD
  RE_DOKUMENT
  PROJEKT_INSTALACJI
  DECYZJA_POZWOLENIE
  FAKTURA_USLUGOWA
  DOKUMENT_TECHNICZNY
  INNE
}

enum EnergyOperator {
  ENEA
  PGE
  TAURON
  ENERGA
  STOEN
  INNY
}

enum EnergyMeasurementKind {
  ACTIVE_IMPORT
  ACTIVE_EXPORT
}

enum EmailStatus {
  QUEUED
  SENT
  FAILED
}

model Role {
  id          String        @id @default(cuid())
  code        StaffRoleCode @unique
  name        String
  permissions Json
  staffUsers  StaffUser[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model CompanyRole {
  id        String                 @id @default(cuid())
  code      CompanyRoleCode        @unique
  name      String
  sortOrder Int                    @default(0)
  users     StaffUserCompanyRole[]
  createdAt DateTime               @default(now())
  updatedAt DateTime               @updatedAt

  @@index([sortOrder])
}

model StaffUser {
  id                      String                      @id @default(cuid())
  email                   String                      @unique
  name                    String
  phone                   String?
  active                  Boolean                     @default(true)
  systemRole              StaffSystemRole             @default(USER)
  positionTitle           String?
  avatarUrl               String?
  passwordHash            String?
  passwordResetRequired   Boolean                     @default(true)
  lastLoginAt             DateTime?
  roleId                  String
  role                    Role                        @relation(fields: [roleId], references: [id])
  companyRoles            StaffUserCompanyRole[]
  ownedProjects           Project[]                   @relation("ProjectOwner")
  assignedTasks           Task[]                      @relation("TaskAssignee")
  assistedTasks           TaskAssistant[]
  createdTasks            Task[]                      @relation("TaskCreator")
  taskComments            TaskComment[]
  notificationsReceived   PanelNotification[]         @relation("NotificationRecipient")
  notificationsCreated    PanelNotification[]         @relation("NotificationActor")
  reminders               Reminder[]
  uploadedDocs            Document[]                  @relation("DocumentUploader")
  ledInstallations        Installation[]              @relation("InstallationTeamLead")
  installationTeams       InstallationTeamMember[]
  completedChecklistItems InstallationChecklistItem[] @relation("InstallationChecklistCompletedBy")
  auditLogs               AuditLog[]                  @relation("AuditActor")
  sessions                StaffSession[]
  activities              Activity[]
  energyScenariosCreated  EnergyScenario[]
  siteAuditsAssigned      SiteAudit[]                 @relation("SiteAuditAuditor")
  siteAuditsCreated       SiteAudit[]                 @relation("SiteAuditCreator")
  assignedServiceTickets  ServiceTicket[]             @relation("ServiceTicketAssignee")
  createdAt               DateTime                    @default(now())
  updatedAt               DateTime                    @updatedAt

  @@index([roleId])
  @@index([systemRole])
  @@index([active])
}

model StaffSession {
  id          String    @id @default(cuid())
  tokenHash   String    @unique @db.Char(64)
  staffUserId String
  staffUser   StaffUser @relation(fields: [staffUserId], references: [id], onDelete: Cascade)
  expiresAt   DateTime
  lastSeenAt  DateTime  @default(now())
  revokedAt   DateTime?
  userAgent   String?   @db.VarChar(500)
  ipHash      String?   @db.Char(64)
  createdAt   DateTime  @default(now())

  @@index([staffUserId, revokedAt, expiresAt])
  @@index([expiresAt])
}

model StaffUserCompanyRole {
  staffUserId   String
  staffUser     StaffUser   @relation(fields: [staffUserId], references: [id], onDelete: Cascade)
  companyRoleId String
  companyRole   CompanyRole @relation(fields: [companyRoleId], references: [id], onDelete: Cascade)
  assignedAt    DateTime    @default(now())

  @@id([staffUserId, companyRoleId])
  @@index([companyRoleId])
}

model Client {
  id                     String                  @id @default(cuid())
  displayName            String
  clientType             ClientType              @default(UNKNOWN)
  taxId                  String?
  clientProblem          String?                 @db.Text
  expectedResult         String?                 @db.Text
  notes                  String?                 @db.Text
  pipedrivePersonId      String?                 @unique
  contacts               Contact[]
  investmentSites        InvestmentSite[]
  projects               Project[]
  tasks                  Task[]
  reminders              Reminder[]
  documents              Document[]
  energyPortalAccounts   EnergyPortalAccount[]
  energyMeasurementFiles EnergyMeasurementFile[]
  auditLogs              AuditLog[]
  activities             Activity[]
  serviceTickets         ServiceTicket[]
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt

  @@index([displayName])
  @@index([clientType])
}

model Contact {
  id                String   @id @default(cuid())
  clientId          String
  client            Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  name              String?
  email             String?
  phone             String?
  addressLine       String?
  postalCode        String?
  city              String?
  investmentAddress String?
  latitude          Decimal? @db.Decimal(10, 7)
  longitude         Decimal? @db.Decimal(10, 7)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([clientId])
  @@index([email])
  @@index([phone])
}

model InvestmentSite {
  id              String    @id @default(cuid())
  clientId        String
  client          Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  name            String?
  addressLine     String?
  postalCode      String?
  city            String?
  fullAddress     String?
  latitude        Decimal?  @db.Decimal(10, 7)
  longitude       Decimal?  @db.Decimal(10, 7)
  source          String?
  pipedriveOrgId  String?
  pipedriveDealId String?   @unique
  notes           String?   @db.Text
  projects        Project[]
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([clientId])
  @@index([city])
  @@index([source])
}

model PipelineStage {
  id                 String         @id @default(cuid())
  code               String?        @unique
  name               String
  sortOrder          Int
  color              String?
  status             ProjectStatus  @default(W_TRAKCIE_OBSLUGI)
  isTerminal         Boolean        @default(false)
  isActive           Boolean        @default(true)
  requiresOwner      Boolean        @default(true)
  requiresNextAction Boolean        @default(true)
  source             String         @default("LOCAL")
  pipedriveStageId   String?        @unique
  projects           Project[]
  workflowRules      WorkflowRule[]
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  @@index([sortOrder])
}

model Project {
  id                     String                  @id @default(cuid())
  clientId               String
  client                 Client                  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  investmentSiteId       String?
  investmentSite         InvestmentSite?         @relation(fields: [investmentSiteId], references: [id], onDelete: SetNull)
  clientType             ClientType              @default(UNKNOWN)
  title                  String
  status                 ProjectStatus           @default(LEAD)
  stageId                String?
  stage                  PipelineStage?          @relation(fields: [stageId], references: [id])
  ownerId                String?
  owner                  StaffUser?              @relation("ProjectOwner", fields: [ownerId], references: [id])
  nextActionTitle        String?
  nextActionAt           DateTime?
  closedAt               DateTime?
  source                 String?
  pipedriveDealId        String?                 @unique
  dashboardStation       String?
  dashboardStationNumber String?
  weatherStationNumber   String?
  locationAddress        String?
  notes                  String?                 @db.Text
  expectedCloseAt        DateTime?
  saleDate               DateTime?
  installationDate       DateTime?
  tasks                  Task[]
  reminders              Reminder[]
  existingAssets         ProjectExistingAsset[]
  configurations         Configuration[]
  offers                 Offer[]
  contracts              Contract[]
  installations          Installation[]
  documents              Document[]
  energyPortalAccounts   EnergyPortalAccount[]
  energyMeasurementFiles EnergyMeasurementFile[]
  activities             Activity[]
  energyAudits           EnergyAudit[]
  siteAudits             SiteAudit[]
  purchaseOrders         PurchaseOrder[]
  stockReservations      StockReservation[]
  odsCase                OdsCase?
  serviceTickets         ServiceTicket[]
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt

  @@index([clientId])
  @@index([investmentSiteId])
  @@index([clientType])
  @@index([stageId])
  @@index([ownerId])
  @@index([status])
  @@index([nextActionAt])
  @@index([source])
  @@index([dashboardStation])
  @@index([dashboardStationNumber])
}

model EnergyAudit {
  id                   String                 @id @default(cuid())
  projectId            String                 @unique
  project              Project                @relation(fields: [projectId], references: [id], onDelete: Cascade)
  status               EnergyAuditStatus      @default(DRAFT)
  profileSource        EnergyProfileSource    @default(ANNUAL_DECLARATION)
  annualConsumptionKwh Decimal?               @db.Decimal(12, 3)
  hasOperatorData      Boolean?
  hasEnergyInvoices    Boolean?
  connectionPowerKw    Decimal?               @db.Decimal(10, 3)
  phaseCount           Int?
  mainFuseA            Int?
  roofType             ConfigurationRoofType?
  roofAreaM2           Decimal?               @db.Decimal(10, 2)
  roofOrientation      String?
  roofTiltDeg          Decimal?               @db.Decimal(5, 2)
  shadingNotes         String?                @db.Text
  existingPvKw         Decimal?               @db.Decimal(10, 3)
  existingInverter     String?
  existingBatteryKwh   Decimal?               @db.Decimal(10, 3)
  notes                String?                @db.Text
  scenarios            EnergyScenario[]
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt

  @@index([projectId, updatedAt])
  @@index([status])
}

model SiteAudit {
  id              String          @id @default(cuid())
  projectId       String
  project         Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title           String
  status          SiteAuditStatus @default(DRAFT)
  schemaVersion   Int             @default(1)
  visitDate       DateTime?
  auditorId       String?
  auditor         StaffUser?      @relation("SiteAuditAuditor", fields: [auditorId], references: [id], onDelete: SetNull)
  createdById     String?
  createdBy       StaffUser?      @relation("SiteAuditCreator", fields: [createdById], references: [id], onDelete: SetNull)
  currentStep     Int             @default(1)
  completedSteps  Json?
  progressPercent Int             @default(0)
  formData        Json
  completedAt     DateTime?
  documents       Document[]
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([projectId, updatedAt])
  @@index([status])
  @@index([auditorId])
  @@index([createdById])
  @@index([visitDate])
}

model EnergyScenario {
  id                 String      @id @default(cuid())
  auditId            String
  audit              EnergyAudit @relation(fields: [auditId], references: [id], onDelete: Cascade)
  name               String
  engineVersion      String
  inputSnapshot      Json
  resultSnapshot     Json
  pvPowerKw          Decimal     @db.Decimal(10, 3)
  batteryCapacityKwh Decimal     @db.Decimal(10, 3)
  investmentGross    Decimal?    @db.Decimal(12, 2)
  recommended        Boolean     @default(false)
  createdById        String?
  createdBy          StaffUser?  @relation(fields: [createdById], references: [id], onDelete: SetNull)
  offers             Offer[]
  createdAt          DateTime    @default(now())

  @@index([auditId, createdAt])
  @@index([createdById])
  @@index([recommended])
}

model Activity {
  id           String       @id @default(cuid())
  type         ActivityType
  title        String
  body         String?      @db.Text
  clientId     String?
  client       Client?      @relation(fields: [clientId], references: [id], onDelete: SetNull)
  projectId    String?
  project      Project?     @relation(fields: [projectId], references: [id], onDelete: SetNull)
  actorId      String?
  actor        StaffUser?   @relation(fields: [actorId], references: [id], onDelete: SetNull)
  occurredAt   DateTime     @default(now())
  nextActionAt DateTime?
  metadata     Json?
  createdAt    DateTime     @default(now())

  @@index([clientId, occurredAt])
  @@index([projectId, occurredAt])
  @@index([actorId, occurredAt])
  @@index([type, occurredAt])
}

model WorkflowRule {
  id              String        @id @default(cuid())
  name            String
  triggerStageId  String
  triggerStage    PipelineStage @relation(fields: [triggerStageId], references: [id], onDelete: Cascade)
  active          Boolean       @default(true)
  taskTitle       String
  taskDescription String?       @db.Text
  taskPriority    TaskPriority  @default(NORMAL)
  dueOffsetDays   Int           @default(2)
  assignToOwner   Boolean       @default(true)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([triggerStageId, active])
}

model Task {
  id             String              @id @default(cuid())
  clientId       String?
  client         Client?             @relation(fields: [clientId], references: [id], onDelete: SetNull)
  projectId      String?
  project        Project?            @relation(fields: [projectId], references: [id], onDelete: SetNull)
  installationId String?
  installation   Installation?       @relation(fields: [installationId], references: [id], onDelete: SetNull)
  title          String
  description    String?             @db.Text
  status         TaskStatus          @default(OPEN)
  priority       TaskPriority        @default(NORMAL)
  dueAt          DateTime?
  assignedToId   String?
  assignedTo     StaffUser?          @relation("TaskAssignee", fields: [assignedToId], references: [id])
  createdById    String?
  createdBy      StaffUser?          @relation("TaskCreator", fields: [createdById], references: [id])
  completedAt    DateTime?
  assistants     TaskAssistant[]
  comments       TaskComment[]
  notifications  PanelNotification[]
  reminders      Reminder[]
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@index([clientId])
  @@index([projectId])
  @@index([installationId])
  @@index([assignedToId])
  @@index([createdById])
  @@index([priority])
  @@index([status, dueAt])
}

model TaskAssistant {
  taskId      String
  task        Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  staffUserId String
  staffUser   StaffUser @relation(fields: [staffUserId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())

  @@id([taskId, staffUserId])
  @@index([staffUserId])
}

model TaskComment {
  id        String     @id @default(cuid())
  taskId    String
  task      Task       @relation(fields: [taskId], references: [id], onDelete: Cascade)
  authorId  String?
  author    StaffUser? @relation(fields: [authorId], references: [id], onDelete: SetNull)
  body      String     @db.Text
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([taskId])
  @@index([authorId])
}

model PanelNotification {
  id          String     @id @default(cuid())
  staffUserId String
  staffUser   StaffUser  @relation("NotificationRecipient", fields: [staffUserId], references: [id], onDelete: Cascade)
  actorId     String?
  actor       StaffUser? @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)
  taskId      String?
  task        Task?      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  type        String
  title       String
  message     String?    @db.Text
  href        String?
  readAt      DateTime?
  createdAt   DateTime   @default(now())

  @@index([staffUserId, readAt, createdAt])
  @@index([taskId])
  @@index([actorId])
  @@index([type])
}

model Reminder {
  id          String          @id @default(cuid())
  taskId      String?
  task        Task?           @relation(fields: [taskId], references: [id], onDelete: Cascade)
  clientId    String?
  client      Client?         @relation(fields: [clientId], references: [id], onDelete: SetNull)
  projectId   String?
  project     Project?        @relation(fields: [projectId], references: [id], onDelete: SetNull)
  staffUserId String?
  staffUser   StaffUser?      @relation(fields: [staffUserId], references: [id], onDelete: SetNull)
  title       String
  message     String?         @db.Text
  remindAt    DateTime
  channel     ReminderChannel @default(PANEL)
  sentAt      DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([taskId])
  @@index([clientId])
  @@index([projectId])
  @@index([staffUserId])
  @@index([remindAt, sentAt])
}

model Product {
  id                       String                      @id @default(cuid())
  sku                      String?                     @unique
  name                     String
  availability             String?
  producer                 String?
  supplier                 String?
  supplierSku              String?
  supplierUrl              String?
  category                 ProductCategory
  clientType               ClientType?
  description              String?                     @db.Text
  powerCapacity            String?
  voltageKind              String?
  notes                    String?                     @db.Text
  sourceSheet              String?
  sourceRow                Int?
  supplierSyncedAt         DateTime?
  prices                   ProductPrice[]
  media                    ProductMedia[]
  configItems              ConfigurationItem[]
  templateItems            ConfigurationTemplateItem[]
  existingAssets           ProjectExistingAsset[]
  installationPlannedItems InstallationPlannedItem[]
  installed                InstalledDevice[]
  purchaseOrderItems       PurchaseOrderItem[]
  stockReservations        StockReservation[]
  createdAt                DateTime                    @default(now())
  updatedAt                DateTime                    @updatedAt

  @@index([name])
  @@index([category])
  @@index([producer])
  @@index([supplierSku])
}

model ProductPrice {
  id                 String   @id @default(cuid())
  productId          String
  product            Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  purchaseNet        Decimal  @db.Decimal(12, 2)
  currentPurchaseNet Decimal? @db.Decimal(12, 2)
  purchaseVatRate    Decimal  @db.Decimal(5, 4)
  operatingCostNet   Decimal  @db.Decimal(12, 2)
  marginRate         Decimal  @db.Decimal(5, 4)
  saleVatRate        Decimal? @db.Decimal(5, 4)
  currency           String   @default("PLN")
  validFrom          DateTime @default(now())
  createdAt          DateTime @default(now())

  @@index([productId, validFrom])
}

model ProductMedia {
  id          String   @id @default(cuid())
  productId   String
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  url         String?
  storagePath String?
  kind        String
  altText     String?
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())

  @@index([productId])
}

model ConfigurationTemplate {
  id                       String                      @id @default(cuid())
  familyKey                String                      @db.VarChar(80)
  name                     String
  version                  Int                         @default(1)
  isActive                 Boolean                     @default(true)
  kind                     ConfigurationKind
  clientType               ClientType
  roofType                 ConfigurationRoofType?
  goal                     ConfigurationGoal?
  powerKw                  Decimal?                    @db.Decimal(8, 3)
  capacityKwh              Decimal?                    @db.Decimal(8, 3)
  sortOrder                Int                         @default(0)
  requiresExistingPv       Boolean                     @default(false)
  requiresExistingInverter Boolean                     @default(false)
  sourceSheet              String?
  sourceRange              String?
  notes                    String?                     @db.Text
  items                    ConfigurationTemplateItem[]
  configs                  Configuration[]
  createdAt                DateTime                    @default(now())
  updatedAt                DateTime                    @updatedAt

  @@unique([sourceSheet, sourceRange])
  @@index([familyKey, isActive])
  @@index([kind, clientType])
  @@index([goal])
  @@index([roofType])
}

model ConfigurationTemplateItem {
  id               String                      @id @default(cuid())
  templateId       String
  template         ConfigurationTemplate       @relation(fields: [templateId], references: [id], onDelete: Cascade)
  productId        String?
  product          Product?                    @relation(fields: [productId], references: [id], onDelete: SetNull)
  position         Int
  description      String?
  quantity         Decimal                     @db.Decimal(12, 3)
  role             ConfigurationItemRole       @default(OTHER)
  supplyMode       ConfigurationItemSupplyMode @default(ONREVOLT_SUPPLIED)
  unitPurchaseNet  Decimal?                    @db.Decimal(12, 2)
  purchaseVatRate  Decimal?                    @db.Decimal(5, 4)
  operatingCostNet Decimal?                    @db.Decimal(12, 2)
  marginRate       Decimal?                    @db.Decimal(5, 4)
  saleVatRate      Decimal?                    @db.Decimal(5, 4)
  isOptional       Boolean                     @default(false)
  requiresReview   Boolean                     @default(false)
  sourceSheet      String?
  sourceRow        Int?
  notes            String?                     @db.Text

  @@index([templateId])
  @@index([productId])
}

model Configuration {
  id                     String                 @id @default(cuid())
  projectId              String
  project                Project                @relation(fields: [projectId], references: [id], onDelete: Cascade)
  templateId             String?
  template               ConfigurationTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  sourceTemplateVersion  Int?
  name                   String
  kind                   ConfigurationKind
  status                 ConfigurationStatus    @default(DRAFT)
  clientType             ClientType
  goal                   ConfigurationGoal?
  roofType               ConfigurationRoofType?
  targetPowerKw          Decimal?               @db.Decimal(8, 3)
  targetCapacityKwh      Decimal?               @db.Decimal(8, 3)
  existingAssetsSnapshot Json?
  saleVatMode            ConfigurationVatMode   @default(MIXED)
  defaultSaleVatRate     Decimal?               @db.Decimal(5, 4)
  vatBasis               String?
  totalPurchaseNet       Decimal                @default(0) @db.Decimal(12, 2)
  totalSaleGross         Decimal                @default(0) @db.Decimal(12, 2)
  totalProfitNet         Decimal                @default(0) @db.Decimal(12, 2)
  requiresReview         Boolean                @default(false)
  reviewNotes            String?                @db.Text
  items                  ConfigurationItem[]
  offers                 Offer[]
  offerLinks             OfferConfiguration[]
  installations          Installation[]
  stockReservations      StockReservation[]
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt

  @@index([projectId])
  @@index([templateId])
  @@index([status])
}

model ConfigurationItem {
  id                       String                      @id @default(cuid())
  configurationId          String
  configuration            Configuration               @relation(fields: [configurationId], references: [id], onDelete: Cascade)
  productId                String?
  product                  Product?                    @relation(fields: [productId], references: [id], onDelete: SetNull)
  position                 Int
  description              String
  quantity                 Decimal                     @db.Decimal(12, 3)
  role                     ConfigurationItemRole       @default(OTHER)
  supplyMode               ConfigurationItemSupplyMode @default(ONREVOLT_SUPPLIED)
  unitPurchaseNet          Decimal                     @db.Decimal(12, 2)
  purchaseVatRate          Decimal                     @db.Decimal(5, 4)
  operatingCostNet         Decimal                     @db.Decimal(12, 2)
  marginRate               Decimal                     @db.Decimal(5, 4)
  saleVatRate              Decimal                     @db.Decimal(5, 4)
  saleNet                  Decimal                     @db.Decimal(12, 2)
  saleGross                Decimal                     @db.Decimal(12, 2)
  profitNet                Decimal                     @db.Decimal(12, 2)
  vatSurplus               Decimal                     @default(0) @db.Decimal(12, 2)
  isOptional               Boolean                     @default(false)
  requiresReview           Boolean                     @default(false)
  sourceSheet              String?
  sourceRow                Int?
  notes                    String?                     @db.Text
  installationPlannedItems InstallationPlannedItem[]

  @@index([configurationId])
  @@index([productId])
}

model ProjectExistingAsset {
  id                  String                           @id @default(cuid())
  projectId           String
  project             Project                          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  productId           String?
  product             Product?                         @relation(fields: [productId], references: [id], onDelete: SetNull)
  kind                ExistingAssetKind
  name                String
  producer            String?
  model               String?
  powerKw             Decimal?                         @db.Decimal(8, 3)
  capacityKwh         Decimal?                         @db.Decimal(8, 3)
  quantity            Decimal?                         @db.Decimal(12, 3)
  voltageKind         String?
  phaseCount          Int?
  parameters          Json?
  verificationStatus  ExistingAssetVerificationStatus  @default(DECLARED)
  compatibilityStatus ExistingAssetCompatibilityStatus @default(UNKNOWN)
  notes               String?                          @db.Text
  createdAt           DateTime                         @default(now())
  updatedAt           DateTime                         @updatedAt

  @@index([projectId])
  @@index([productId])
  @@index([kind])
}

model Offer {
  id                       String               @id @default(cuid())
  projectId                String
  project                  Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  configurationId          String?
  configuration            Configuration?       @relation(fields: [configurationId], references: [id], onDelete: SetNull)
  energyScenarioId         String?
  energyScenario           EnergyScenario?      @relation(fields: [energyScenarioId], references: [id], onDelete: SetNull)
  number                   String?
  title                    String?
  version                  Int                  @default(1)
  status                   OfferStatus          @default(DRAFT)
  currency                 String               @default("PLN")
  totalNet                 Decimal              @default(0) @db.Decimal(12, 2)
  totalGross               Decimal              @default(0) @db.Decimal(12, 2)
  subsidyGross             Decimal              @default(0) @db.Decimal(12, 2)
  thermoReliefGross        Decimal              @default(0) @db.Decimal(12, 2)
  totalAfterSupportGross   Decimal              @default(0) @db.Decimal(12, 2)
  currentAnnualBillGross   Decimal              @default(0) @db.Decimal(12, 2)
  projectedAnnualBillGross Decimal              @default(0) @db.Decimal(12, 2)
  annualSavingsGross       Decimal              @default(0) @db.Decimal(12, 2)
  paybackYears             Decimal?             @db.Decimal(8, 2)
  tariffBefore             String?
  tariffAfter              String?
  settlementBefore         String?
  settlementAfter          String?
  descriptionBefore        String?              @db.Text
  descriptionAfter         String?              @db.Text
  lineItemsSnapshot        Json?
  energySnapshot           Json?
  calculationSnapshot      Json?
  clientSnapshot           Json?
  validUntil               DateTime?
  sentAt                   DateTime?
  acceptedAt               DateTime?
  notes                    String?              @db.Text
  configurations           OfferConfiguration[]
  contracts                Contract[]
  documents                Document[]
  installations            Installation[]
  purchaseOrders           PurchaseOrder[]
  createdAt                DateTime             @default(now())
  updatedAt                DateTime             @updatedAt

  @@index([projectId])
  @@index([configurationId])
  @@index([energyScenarioId])
  @@index([status])
}

model OfferConfiguration {
  id              String        @id @default(cuid())
  offerId         String
  offer           Offer         @relation(fields: [offerId], references: [id], onDelete: Cascade)
  configurationId String
  configuration   Configuration @relation(fields: [configurationId], references: [id], onDelete: Restrict)
  sortOrder       Int           @default(0)
  createdAt       DateTime      @default(now())

  @@unique([offerId, configurationId])
  @@index([offerId, sortOrder])
  @@index([configurationId])
}

model Contract {
  id                 String         @id @default(cuid())
  projectId          String
  project            Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  offerId            String?
  offer              Offer?         @relation(fields: [offerId], references: [id], onDelete: SetNull)
  number             String?
  status             ContractStatus @default(DRAFT)
  signedAt           DateTime?
  saleGross          Decimal?       @db.Decimal(12, 2)
  deposit            Decimal?       @db.Decimal(12, 2)
  depositPercent     Decimal?       @db.Decimal(5, 2)
  paymentSchedule    Json?
  commercialSnapshot Json?
  notes              String?        @db.Text
  documents          Document[]
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  @@index([projectId])
  @@index([offerId])
  @@index([status])
}

model PurchaseOrder {
  id          String              @id @default(cuid())
  number      String              @unique
  projectId   String
  project     Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  offerId     String?
  offer       Offer?              @relation(fields: [offerId], references: [id], onDelete: SetNull)
  supplier    String
  status      PurchaseOrderStatus @default(DRAFT)
  orderedAt   DateTime?
  expectedAt  DateTime?
  deliveredAt DateTime?
  notes       String?             @db.Text
  items       PurchaseOrderItem[]
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@index([projectId])
  @@index([offerId])
  @@index([supplier])
  @@index([status, expectedAt])
}

model PurchaseOrderItem {
  id               String             @id @default(cuid())
  purchaseOrderId  String
  purchaseOrder    PurchaseOrder      @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  productId        String?
  product          Product?           @relation(fields: [productId], references: [id], onDelete: SetNull)
  name             String
  supplierSku      String?
  quantity         Decimal            @db.Decimal(12, 3)
  receivedQuantity Decimal            @default(0) @db.Decimal(12, 3)
  unitPurchaseNet  Decimal?           @db.Decimal(12, 2)
  reservations     StockReservation[]
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@index([purchaseOrderId])
  @@index([productId])
}

model StockReservation {
  id                  String                 @id @default(cuid())
  projectId           String
  project             Project                @relation(fields: [projectId], references: [id], onDelete: Cascade)
  configurationId     String?
  configuration       Configuration?         @relation(fields: [configurationId], references: [id], onDelete: SetNull)
  productId           String?
  product             Product?               @relation(fields: [productId], references: [id], onDelete: SetNull)
  purchaseOrderItemId String?
  purchaseOrderItem   PurchaseOrderItem?     @relation(fields: [purchaseOrderItemId], references: [id], onDelete: SetNull)
  installationId      String?
  installation        Installation?          @relation(fields: [installationId], references: [id], onDelete: SetNull)
  name                String
  quantity            Decimal                @db.Decimal(12, 3)
  status              StockReservationStatus @default(RESERVED)
  notes               String?                @db.Text
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt

  @@index([projectId, status])
  @@index([configurationId])
  @@index([productId])
  @@index([purchaseOrderItemId])
  @@index([installationId])
}

model Installation {
  id                String                      @id @default(cuid())
  projectId         String
  project           Project                     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  offerId           String?
  offer             Offer?                      @relation(fields: [offerId], references: [id], onDelete: SetNull)
  configurationId   String?
  configuration     Configuration?              @relation(fields: [configurationId], references: [id], onDelete: SetNull)
  status            InstallationStatus          @default(TO_SCHEDULE)
  plannedAt         DateTime?
  plannedEndAt      DateTime?
  confirmedAt       DateTime?
  startedAt         DateTime?
  completedAt       DateTime?
  teamLeadId        String?
  teamLead          StaffUser?                  @relation("InstallationTeamLead", fields: [teamLeadId], references: [id], onDelete: SetNull)
  address           String?
  contactName       String?
  contactPhone      String?
  notes             String?                     @db.Text
  internalNotes     String?                     @db.Text
  tasks             Task[]
  teamMembers       InstallationTeamMember[]
  checklistItems    InstallationChecklistItem[]
  plannedItems      InstallationPlannedItem[]
  installedDevices  InstalledDevice[]
  documents         Document[]
  stockReservations StockReservation[]
  createdAt         DateTime                    @default(now())
  updatedAt         DateTime                    @updatedAt

  @@index([projectId])
  @@index([offerId])
  @@index([configurationId])
  @@index([status])
  @@index([plannedAt])
  @@index([teamLeadId])
}

model InstallationTeamMember {
  installationId String
  installation   Installation @relation(fields: [installationId], references: [id], onDelete: Cascade)
  staffUserId    String
  staffUser      StaffUser    @relation(fields: [staffUserId], references: [id], onDelete: Cascade)
  role           String?
  isLead         Boolean      @default(false)
  assignedAt     DateTime     @default(now())

  @@id([installationId, staffUserId])
  @@index([staffUserId])
}

model InstallationChecklistItem {
  id             String       @id @default(cuid())
  installationId String
  installation   Installation @relation(fields: [installationId], references: [id], onDelete: Cascade)
  title          String
  required       Boolean      @default(true)
  completed      Boolean      @default(false)
  completedAt    DateTime?
  completedById  String?
  completedBy    StaffUser?   @relation("InstallationChecklistCompletedBy", fields: [completedById], references: [id], onDelete: SetNull)
  notes          String?      @db.Text
  sortOrder      Int          @default(0)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([installationId])
  @@index([completedById])
  @@index([completed])
}

model InstallationPlannedItem {
  id                  String                      @id @default(cuid())
  installationId      String
  installation        Installation                @relation(fields: [installationId], references: [id], onDelete: Cascade)
  configurationItemId String?
  configurationItem   ConfigurationItem?          @relation(fields: [configurationItemId], references: [id], onDelete: SetNull)
  productId           String?
  product             Product?                    @relation(fields: [productId], references: [id], onDelete: SetNull)
  position            Int                         @default(0)
  name                String
  quantity            Decimal                     @db.Decimal(12, 3)
  role                ConfigurationItemRole       @default(OTHER)
  supplyMode          ConfigurationItemSupplyMode @default(ONREVOLT_SUPPLIED)
  notes               String?                     @db.Text
  installedDevices    InstalledDevice[]
  createdAt           DateTime                    @default(now())
  updatedAt           DateTime                    @updatedAt

  @@index([installationId])
  @@index([configurationItemId])
  @@index([productId])
}

model InstalledDevice {
  id             String                   @id @default(cuid())
  installationId String
  installation   Installation             @relation(fields: [installationId], references: [id], onDelete: Cascade)
  plannedItemId  String?
  plannedItem    InstallationPlannedItem? @relation(fields: [plannedItemId], references: [id], onDelete: SetNull)
  productId      String?
  product        Product?                 @relation(fields: [productId], references: [id], onDelete: SetNull)
  name           String
  serialNumber   String?
  parameters     Json?
  installedAt    DateTime?
  commissionedAt DateTime?
  warrantyMonths Int?
  warrantyUntil  DateTime?
  notes          String?                  @db.Text
  documents      Document[]
  serviceTickets ServiceTicket[]
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt

  @@index([installationId])
  @@index([plannedItemId])
  @@index([productId])
  @@index([serialNumber])
}

model OdsCase {
  id                String             @id @default(cuid())
  projectId         String             @unique
  project           Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  operator          EnergyOperator
  ppeNumber         String?
  applicationNumber String?
  status            OdsCaseStatus      @default(PREPARATION)
  submittedAt       DateTime?
  deadlineAt        DateTime?
  acceptedAt        DateTime?
  completedAt       DateTime?
  notes             String?            @db.Text
  checklistItems    OdsChecklistItem[]
  documents         Document[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@index([status, deadlineAt])
  @@index([operator])
}

model OdsChecklistItem {
  id          String    @id @default(cuid())
  odsCaseId   String
  odsCase     OdsCase   @relation(fields: [odsCaseId], references: [id], onDelete: Cascade)
  title       String
  required    Boolean   @default(true)
  completed   Boolean   @default(false)
  completedAt DateTime?
  sortOrder   Int       @default(0)
  notes       String?   @db.Text
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([odsCaseId, sortOrder])
}

model ServiceTicket {
  id                String              @id @default(cuid())
  number            String              @unique
  clientId          String
  client            Client              @relation(fields: [clientId], references: [id], onDelete: Cascade)
  projectId         String?
  project           Project?            @relation(fields: [projectId], references: [id], onDelete: SetNull)
  installedDeviceId String?
  installedDevice   InstalledDevice?    @relation(fields: [installedDeviceId], references: [id], onDelete: SetNull)
  assignedToId      String?
  assignedTo        StaffUser?          @relation("ServiceTicketAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  title             String
  description       String              @db.Text
  status            ServiceTicketStatus @default(NEW)
  priority          TaskPriority        @default(NORMAL)
  warrantyClaim     Boolean             @default(false)
  dueAt             DateTime?
  resolvedAt        DateTime?
  resolution        String?             @db.Text
  documents         Document[]
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  @@index([clientId, status])
  @@index([projectId])
  @@index([installedDeviceId])
  @@index([assignedToId, status])
  @@index([dueAt])
}

model Document {
  id                     String                  @id @default(cuid())
  type                   DocumentType
  title                  String
  fileName               String
  mimeType               String?
  sizeBytes              Int?
  sha256                 String?
  storagePath            String
  clientId               String?
  client                 Client?                 @relation(fields: [clientId], references: [id], onDelete: SetNull)
  projectId              String?
  project                Project?                @relation(fields: [projectId], references: [id], onDelete: SetNull)
  offerId                String?
  offer                  Offer?                  @relation(fields: [offerId], references: [id], onDelete: SetNull)
  contractId             String?
  contract               Contract?               @relation(fields: [contractId], references: [id], onDelete: SetNull)
  installationId         String?
  installation           Installation?           @relation(fields: [installationId], references: [id], onDelete: SetNull)
  installedDeviceId      String?
  installedDevice        InstalledDevice?        @relation(fields: [installedDeviceId], references: [id], onDelete: SetNull)
  odsCaseId              String?
  odsCase                OdsCase?                @relation(fields: [odsCaseId], references: [id], onDelete: SetNull)
  serviceTicketId        String?
  serviceTicket          ServiceTicket?          @relation(fields: [serviceTicketId], references: [id], onDelete: SetNull)
  siteAuditId            String?
  siteAudit              SiteAudit?              @relation(fields: [siteAuditId], references: [id], onDelete: SetNull)
  auditFieldKey          String?
  energyMeasurementFiles EnergyMeasurementFile[]
  uploadedById           String?
  uploadedBy             StaffUser?              @relation("DocumentUploader", fields: [uploadedById], references: [id], onDelete: SetNull)
  visibleToClient        Boolean                 @default(false)
  documentDate           DateTime?
  tags                   Json?
  billingPeriodFrom      DateTime?
  billingPeriodTo        DateTime?
  billingCycleMonths     Int?
  invoiceNumber          String?
  amountGross            Decimal?                @db.Decimal(12, 2)
  amountDue              Decimal?                @db.Decimal(12, 2)
  invoiceProvider        String?
  invoiceParserId        String?
  invoiceParserVersion   String?
  invoiceConfidence      Decimal?                @db.Decimal(5, 4)
  invoicePpeNumber       String?
  invoiceTariff          String?
  energyConsumptionKwh   Decimal?                @db.Decimal(14, 3)
  invoiceRecognition     Json?
  notes                  String?                 @db.Text
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt

  @@index([clientId])
  @@index([projectId])
  @@index([type])
  @@index([documentDate])
  @@index([billingPeriodFrom, billingPeriodTo])
  @@index([invoicePpeNumber])
  @@index([sha256])
  @@index([odsCaseId])
  @@index([serviceTicketId])
  @@index([siteAuditId, auditFieldKey])
}

model EnergyPortalAccount {
  id                String                  @id @default(cuid())
  clientId          String
  client            Client                  @relation(fields: [clientId], references: [id], onDelete: Cascade)
  projectId         String?
  project           Project?                @relation(fields: [projectId], references: [id], onDelete: SetNull)
  operator          EnergyOperator          @default(ENEA)
  login             String?
  encryptedPassword String?                 @db.Text
  tariff            String?
  ppeNumber         String?
  portalPpeId       String?
  meterNumber       String?
  notes             String?                 @db.Text
  lastSyncAt        DateTime?
  lastSyncStatus    String?
  lastSyncMessage   String?                 @db.Text
  measurementFiles  EnergyMeasurementFile[]
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt

  @@index([clientId])
  @@index([projectId])
  @@index([operator])
}

model EnergyMeasurementFile {
  id           String                @id @default(cuid())
  accountId    String
  account      EnergyPortalAccount   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  clientId     String
  client       Client                @relation(fields: [clientId], references: [id], onDelete: Cascade)
  projectId    String?
  project      Project?              @relation(fields: [projectId], references: [id], onDelete: SetNull)
  operator     EnergyOperator        @default(ENEA)
  kind         EnergyMeasurementKind
  periodYear   Int
  periodMonth  Int
  aggregation  String                @default("60 min")
  dataSource   String                @default("Dane po bilansowaniu")
  documentId   String?
  document     Document?             @relation(fields: [documentId], references: [id], onDelete: SetNull)
  storagePath  String?
  fileName     String?
  status       String                @default("DOWNLOADED")
  error        String?               @db.Text
  downloadedAt DateTime?
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt

  @@unique([accountId, kind, periodYear, periodMonth])
  @@index([clientId])
  @@index([projectId])
  @@index([documentId])
  @@index([operator])
  @@index([periodYear, periodMonth])
}

model PipedriveSyncState {
  id             String    @id @default(cuid())
  entityType     String
  pipedriveId    String
  localModel     String?
  localId        String?
  rawSnapshot    Json
  importedAt     DateTime  @default(now())
  syncedAt       DateTime?
  requiresReview Boolean   @default(false)
  reviewReason   String?   @db.Text

  @@unique([entityType, pipedriveId])
  @@index([localModel, localId])
  @@index([requiresReview])
}

model AuditLog {
  id         String     @id @default(cuid())
  actorId    String?
  actor      StaffUser? @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  clientId   String?
  client     Client?    @relation(fields: [clientId], references: [id], onDelete: SetNull)
  entityType String
  entityId   String
  action     String
  before     Json?
  after      Json?
  createdAt  DateTime   @default(now())

  @@index([actorId])
  @@index([clientId])
  @@index([entityType, entityId])
  @@index([createdAt])
}

model EmailMessage {
  id          String      @id @default(cuid())
  to          String
  subject     String
  body        String      @db.Text
  status      EmailStatus @default(QUEUED)
  scheduledAt DateTime?
  sentAt      DateTime?
  error       String?     @db.Text
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([status, scheduledAt])
}
