{
  "name": "horizon-ui-chakra-nextjs-pro",
  "version": "3.0.0",
  "private": true,
  "scripts": {
    "dev": "node --use-system-ca node_modules/next/dist/bin/next dev",
    "build": "node --use-system-ca node_modules/next/dist/bin/next build",
    "start": "node --use-system-ca node_modules/next/dist/bin/next start",
    "export": "next export",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "crm:ods:dry-run": "tsx scripts/import-onrevolt-ods.ts --dry-run",
    "crm:templates:dry-run": "tsx scripts/import-configuration-templates.ts",
    "crm:templates:apply": "tsx scripts/import-configuration-templates.ts --apply",
    "crm:grid-meters:seed": "tsx scripts/seed-grid-meters.ts",
    "crm:legacy-sellers:import": "tsx scripts/import-legacy-sellers.ts",
    "crm:email:send": "tsx scripts/process-email-queue.ts",
    "crm:pipeline:reconcile": "tsx scripts/reconcile-pipeline-stages.ts",
    "test:crm": "tsx --test src/lib/onrevolt/*.test.ts",
    "test:configuration-integration": "node --env-file=.env.local --import tsx scripts/verify-configuration-workflow.ts",
    "lint": "next lint",
    "predeploy": "yarn run build",
    "deploy": "gh-pages -d build"
  },
  "dependencies": {
    "@babel/preset-react": "^7.18.6",
